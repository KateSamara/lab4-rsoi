{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "LibrarySystemConfiguration" : {
    "IpAddress": "http://library-system:8060",
    "BaseUrl": "api/v1/libraries",
    "GetBooksSuffix": "books",
    "BaseBookUrl": "api/v1/books",
    "SearchByIdsSuffix": "ids",
    "CheckHealth": "/manage/health"
  },
  
  "ReservationSystemConfiguration" : {
    "IpAddress": "http://reservation-system:8070",
    "BaseUrl": "api/v1/reservations",
    "UsernameHeader": "X-User-Name",
    "CheckHealth": "/manage/health"
  },
  
  "RatingSystemConfiguration" : {
    "IpAddress": "http://rating-system:8050",
    "BaseUrl": "api/v1/ratings",
    "UsernameHeader": "X-User-Name",
    "CheckHealth": "/manage/health"
  },
  
  "CircuitBreakerConfiguration" : {
    "FailureThreshold": 3,
    "Timeout": 10
  }
}
